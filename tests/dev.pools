# Test pools of the child theme in development mode, for bin/run of wp-test-env
# (https://github.com/webcodingcat/wp-test-env), e.g. from its directory:
#
#   bin/run ../theme-dev-test-child/tests/dev.pools
#
# Every instance runs the checkouts with the framework checkout linked into vendor/:
# the child theme active on the test theme, with the test plugin.
prepare theme-dev-test theme-dev-test-child plugin-dev-test
link webcodingcat/wp-app-framework=wp-app-framework
link webcodingcat/plugin-dev-test=plugin-dev-test
link webcodingcat/theme-dev-test=theme-dev-test

pool tdtc
themes theme-dev-test theme-dev-test-child
plugins plugin-dev-test
activate theme-dev-test-child
e2e theme-dev-test-child
